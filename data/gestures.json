 "rules": [
  "一筆畫完,手指放開才算數;畫的時候不會出招",
  "起筆要在右下的大圈裡,畫出圈外也算同一筆",
  "「前」是你面對的方向;面向左時所有左右相反,上下不變",
  "只用上下左右直線組合;畫歪一點也行,系統會挑最接近的招(放錯招也沒關係)",
  "點一下大圈不會有任何事;普攻在大圈左邊的小鈕"
 ],
 "stepsHelp": [
  "前衝:往前畫一筆,可連畫 2~4 次追人;從跑步中直接畫也行",
  "後滑:往後畫一筆,連用可以拉開距離逃跑",
  "縱步:往上或往下畫一筆,錯開射彈",
  "月步靠「步力條」(HUD 青色細條),不吃 MP;鍵盤用 K 鍵"
 ],
 "tutorial": [
  {
   "title": "1/4 走路",
   "text": "左半邊畫面按住滑動就能走,推到最外圈會自動跑"
  },
  {
   "title": "2/4 普攻",
   "text": "點右邊的小「攻」鈕出拳,連點出連段(傷害低,用來牽制)"
  },
  {
   "title": "3/4 月步",
   "text": "在右下大圈往右畫一筆 = 前衝,再畫一次連續前衝;往左畫 = 後滑"
  },
  {
   "title": "4/4 必殺技",
   "text": "沿著虛線範本,在大圈畫出第一招的手勢,放開就出招"
  }
 ]
}