  "info": {
    "moves": {
      "sp_fwd_atk": {
        "name": "龜殼滑球",
        "desc": "拔下龜殼貼地滑出去撞人,碰到場邊或飛遠會滑回來再撞一次;殼沒回來前不能再丟"
      },
      "sp_fwd_jump": {
        "name": "星星糖無敵衝",
        "desc": "吃下星星糖(這段會被打斷)後無敵衝刺,可用方向鍵操控,撞到的人各撞飛一次;衝完很喘"
      },
      "sp_down_atk": {
        "name": "縮頭烏龜",
        "desc": "縮進殼裡擺架式:被近戰碰到自動殼旋轉反擊,被射彈打到原路彈回;擋不住投技與零傷害控制"
      }
    },
    "ult": {
      "name": "星光殼大地震",
      "desc": "變成金色星光殼旋轉(無敵,全場看得到預告)後跳起砸地,全場地面上的敵人都跌倒受傷、不可防;看到預告抓時機跳起、翻滾或已倒地都能躲過"
    }
  },
