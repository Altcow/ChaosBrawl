      },
      "sp_fwd_jump": {
        "name": "豬突猛進",
        "desc": "低頭直線衝撞,路上每個人各撞一次並擊倒;前半段有霸體(只擋近戰輕攻擊,擋不住射彈與投技)"
      },
      "sp_up_atk": {
        "name": "旋風豬上天",
