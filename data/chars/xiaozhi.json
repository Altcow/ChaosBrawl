    "moves": {
      "sp_fwd_atk": {
        "name": "劈哩啪啦",
        "desc": "丟球放出雷丸鼠,放電射出閃電;命中長硬直,來得及補一招"
      },
      "sp_fwd_jump": {
        "name": "消防水柱",
        "desc": "丟球放出水塔龜,噴水柱把近身的人一路推開,最後一下擊倒;近身解圍"
      },
      "sp_down_atk": {
        "name": "藤蔓絆腳",
        "desc": "丟球放出花背蛙,在前方地上種出藤蔓陷阱;第一個踩到的人被纏住不能動,可繞開或跳過"
      }
    },
    "ult": {
      "name": "爆炎大俯衝",
      "desc": "丟球召喚炎爪龍橫越全畫面俯衝,穿透並擊倒;可防、錯開縱深、翻滾、跳起躲開;龍飛出後不會因為小志被打而消失"
    }
  },
